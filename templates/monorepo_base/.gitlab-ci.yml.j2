# GitLab CI configuration for {{ project_name }}

stages:
  - lint
  - test
  - security
  - package
  - pages
  - deploy
  - release

variables:
  DOCKER_DRIVER: overlay2
  DOCKER_TLS_CERTDIR: "/certs"

# Lint stage - code quality checks
lint:
  stage: lint
  image: python:{{ python_version }}
  before_script:
    - python -m pip install --upgrade pip
    - pip install uv
  script:
    - uv sync --dev
    - uv run ruff check .
    - uv run mypy .
    - uv run bash check_licenses.sh
  only:
    - merge_requests
    - main
    - develop
  interruptible: true

# Test stage - run test suite
test:
  stage: test
  image: python:{{ python_version }}
  before_script:
    - python -m pip install --upgrade pip
    - pip install uv
  script:
    - uv sync --dev
    - |
      uv run pytest --cov-report=xml --cov-report=html --junitxml=test-results.xml || exit_code=$?
      if [ $exit_code -eq 5 ]; then
        echo "No tests collected, treating as success."
        exit_code=0
      fi

      if [ ! -f coverage.xml ]; then
        echo "No tests ran, creating empty coverage.xml"
        echo '<?xml version="1.0"?><coverage line-rate="0" branch-rate="0" version="5.0" timestamp="0"></coverage>' > coverage.xml
      fi

      exit $exit_code
  artifacts:
    reports:
      junit: test-results.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml
    paths:
      - htmlcov/
      - dist/
      - licenses.txt
      - requirements-freeze.txt
      - coverage.xml
    expire_in: 1 week
  coverage: '/TOTAL.*\s+(\d+%)$/'
  only:
    - merge_requests
    - main
    - develop
  interruptible: true

# Security stage - vulnerability scanning
security:
  stage: security
  image:
    name: aquasec/trivy:latest
    entrypoint: [""]
  script:
    - echo "Starting Trivy scan on source code..."
    # Scan the filesystem (source code) and output SARIF format to a file
    - trivy fs --format sarif --output trivy-results.sarif .
  artifacts:
    paths:
      - trivy-results.sarif
    reports:
      sast: trivy-results.sarif
    expire_in: 1 week

# Package stage - build Python packages
package:
  stage: package
  image: python:{{ python_version }}
  before_script:
    - python -m pip install --upgrade pip
    - pip install uv
  script:
    - uv sync --dev
    - |
      for dir in packages/*/; do
        echo "Building $dir"
        uv build "$dir" --out-dir dist
      done
  artifacts:
    paths:
      - dist/
    expire_in: 1 week
  only:
    - merge_requests
    - main
    - develop
  interruptible: true

# Pages stage - build documentation
pages:
  stage: pages
  image: python:{{ python_version }}
  before_script:
    - python -m pip install --upgrade pip
    - pip install uv
  script:
    - uv sync --dev
    - uv run mkdocs build
    - mv site public
  artifacts:
    paths:
      - public
  only:
    - main
  interruptible: true

# Deploy stage - deploy to GitLab Pages and Package Registry
deploy:
  stage: deploy
  image: python:{{ python_version }}
  before_script:
    - python -m pip install --upgrade pip
    - pip install uv
  script:
    - uv sync --dev
    - uv build
    - echo "Package built successfully"
  artifacts:
    paths:
      - dist/
  only:
    - main
  when: manual
  interruptible: true

# Release stage - publish to PyPI and create GitLab release
release:
  stage: release
  image: python:{{ python_version }}
  before_script:
    - python -m pip install --upgrade pip
    - pip install uv
    - pip install twine
  script:
    # Install dependencies
    - uv sync --dev
    
    # Run tests to ensure quality before release
    - |
      uv run pytest --cov-report=xml --cov-report=html --junitxml=test-results.xml || exit_code=$?
      if [ $exit_code -eq 5 ]; then
        echo "No tests collected, treating as success."
        exit_code=0
      fi

      if [ ! -f coverage.xml ]; then
        echo "No tests ran, creating empty coverage.xml"
        echo '<?xml version="1.0"?><coverage line-rate="0" branch-rate="0" version="5.0" timestamp="0"></coverage>' > coverage.xml
      fi

      exit $exit_code
    
    # Build packages
    - |
      for dir in packages/*/; do
        echo "Building $dir"
        uv build "$dir" --out-dir dist
      done
    
    # Publish to PyPI
    - |
      if [ -n "$PYPI_API_TOKEN" ]; then
        echo "Publishing to PyPI..."
        twine upload --username __token__ --password "$PYPI_API_TOKEN" dist/*
      else
        echo "PYPI_API_TOKEN not set, skipping PyPI upload"
      fi
    
    # Create GitLab release
    - |
      # Extract version from tag (remove 'v' prefix if present)
      VERSION=${CI_COMMIT_TAG#v}
      
      # Create release notes
      cat > release_notes.md << EOF
      ## Release $VERSION
      
      This release includes:
      - All packages from the monorepo
      - Built and tested with Python {{ python_version }}
      
      ### Packages
      EOF
      
      # List built packages
      for pkg in dist/*.whl; do
        if [ -f "$pkg" ]; then
          echo "- $(basename "$pkg")" >> release_notes.md
        fi
      done
      
      # Create GitLab release using API
      if [ -n "$GITLAB_TOKEN" ]; then
        echo "Creating GitLab release..."
        curl --request POST \
          --header "PRIVATE-TOKEN: $GITLAB_TOKEN" \
          --header "Content-Type: application/json" \
          --data "{
            \"name\": \"Release $VERSION\",
            \"tag_name\": \"$CI_COMMIT_TAG\",
            \"description\": \"$(cat release_notes.md)\",
            \"assets\": {
              \"links\": []
            }
          }" \
          "$CI_API_V4_URL/projects/$CI_PROJECT_ID/releases"
      else
        echo "GITLAB_TOKEN not set, skipping GitLab release creation"
      fi
  artifacts:
    paths:
      - dist/
      - release_notes.md
    expire_in: 1 week
  only:
    - tags
  when: manual
  interruptible: true
